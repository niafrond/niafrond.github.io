rules_version = '2';
// Mesure d'audience sans donnée personnelle : seuls des compteurs agrégés (jour, site, page, provenance, navigateur, système, langue, fuseau horaire, largeur d'écran, temps de réponse, code HTTP, minute, heure) sont écrits.
// Aucune écriture ne peut contenir autre chose, ni modifier autre chose qu'un +1 sur le jour en cours ; la lecture est publique
// (que des totaux). `expireAt` (+400 jours) est prêt pour une politique TTL, qui exige la facturation : sans elle, purge manuelle.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    function today() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function expiry() {
      return timestamp.date(request.time.year(), request.time.month(), request.time.day()) + duration.value(400, 'd');
    }
    function okHost(h) {
      return h in ['niafrond.github.io', 'houyi.fontaine.one', 'houyi-match3-quest.web.app', 'fontaine.one', 'stats.fontaine.one'];
    }
    function created(id, keys) {
      let d = request.resource.data;
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.day == today() && d.views == 1 && d.expireAt == expiry()
        && d.host is string && okHost(d.host)
        && id.matches(string(d.day) + '_' + d.host + '_.*') && id.size() <= 120;
    }
    function bumped() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1
        && resource.data.day == today();
    }

    match /views/{id} {
      allow read: if isAdmin();
      allow create: if created(id, ['day', 'host', 'path', 'views', 'expireAt'])
        && request.resource.data.path is string && request.resource.data.path.matches('/.*')
        && request.resource.data.path.size() <= 200;
      allow update: if bumped();
    }
    function validDim(dim, v) {
      return dim == 'minute' ? v.matches('^([01][0-9]|2[0-3])[0-5][0-9]$')
        : dim == 'hour' ? v.matches('^([01][0-9]|2[0-3])$')
        : dim == 'browser' ? v in ['chrome', 'safari', 'firefox', 'edge', 'opera', 'samsung', 'autre']
        : dim == 'os' ? v in ['windows', 'macos', 'linux', 'android', 'ios', 'chromeos', 'autre']
        : dim == 'lang' ? v.matches('^[a-z]{2}$')
        : dim == 'tz' ? v.matches('^[A-Za-z_]+(/[A-Za-z_+-]+){0,2}$')
        : dim == 'width' ? v in ['xs', 'sm', 'md', 'lg', 'xl']
        : dim == 'ttfb' ? v in ['lt100', 'lt300', 'lt1000', 'gte1000']
        : dim == 'status' ? v.matches('^[1-5][0-9][0-9]$')
        : false;
    }
    match /dims/{id} {
      allow read: if isAdmin();
      allow create: if created(id, ['day', 'host', 'dim', 'value', 'views', 'expireAt'])
        && request.resource.data.dim is string && request.resource.data.value is string
        && request.resource.data.value.size() <= 40
        && validDim(request.resource.data.dim, request.resource.data.value);
      allow update: if bumped();
    }
    match /refs/{id} {
      allow read: if isAdmin();
      allow create: if created(id, ['day', 'host', 'ref', 'views', 'expireAt'])
        && request.resource.data.ref is string && request.resource.data.ref.size() > 0
        && request.resource.data.ref.size() <= 100;
      allow update: if bumped();
    }
  }
}
